<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.local.netwatch</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>/usr/local/bin/netwatch.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/usr/local/var/log/netwatch.err</string>
	<key>StandardOutPath</key>
	<string>/usr/local/var/log/netwatch.out</string>
	<key>StartInterval</key>
	<integer>300</integer>
</dict>
</plist>
